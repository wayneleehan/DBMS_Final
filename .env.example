# 複製此檔成 .env 後填入你的值：cp .env.example .env

# 本機 MySQL 連線（開發階段推薦）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/anti_fraud_db

# AWS RDS 雲端連線（整合測試用，連線資訊請洽組長）
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/anti_fraud_db

# Cookie session 簽章用 secret（每位開發者請各自產生,不要共用）
# 產生方式：uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=please-generate-your-own-secret

# S3 檔案上傳（通報/申訴有附圖時需要）
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-east-2
S3_BUCKET_NAME=your_bucket_name
